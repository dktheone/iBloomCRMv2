# iBloomCRM v2 Environment Configuration
#
# Copy this file to `.env.local` and populate with your OWN values.
# NEVER commit real secrets to version control. This example file must only
# contain placeholders.

# 1. Supabase Connection (Public & Server Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 2. Meta Tech Provider Configuration (ibloom_connect)
NEXT_PUBLIC_META_APP_ID=your_meta_app_id_here
NEXT_PUBLIC_META_APP_NAME=ibloom_connect
NEXT_PUBLIC_META_APP_MODE=dev
NEXT_PUBLIC_META_BUSINESS_PORTFOLIO_ID=your_meta_business_portfolio_id_here
# Server-only secret. Do NOT prefix with NEXT_PUBLIC_ (that would expose it in the client bundle).
META_APP_SECRET=your_meta_app_secret_here
NEXT_META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_webhook_verify_token_here
NEXT_META_WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token_here

# 3. Master Agency & Tenant Zero Invariants
# NEXT_PUBLIC_TENANT_ZERO_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_MASTER_AGENCY_NAME=iBloom Master Agency (Tenant Zero)
NEXT_PUBLIC_MASTER_AGENCY_SLUG=ibloom-master

# 4. Super Admin Identity Invariants
# NEXT_PUBLIC_SUPER_ADMIN_ID=11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=crm@ibloomsolutions.com
NEXT_PUBLIC_SUPER_ADMIN_NAME=Master Super Admin
# Server-only. Used only for the one-time bootstrap seed. Do NOT prefix with NEXT_PUBLIC_.
SUPER_ADMIN_PASSWORD=choose_a_strong_password_here

# 5. App Domain & Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEBHOOK_URL=https://your-domain.example/api/webhooks/meta
